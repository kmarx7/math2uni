  "blocks": [
    {
      "id": "goals",
      "type": "ConceptBlock",
      "title": "오늘의 학습 목표",
      "body": "• 지수함수 y=aˣ의 정의역·치역·기준점을 밑의 조건과 연결한다.\n• a>1과 0<a<1에 따른 증가·감소 및 평행이동 그래프의 변화를 설명한다.\n검수 전 학습 초안이며 점수 결과를 보장하지 않는다."
    },
    {
      "id": "diagnostic",
      "type": "ExplanationBlock",
      "title": "시작 전 선수학습 확인",
      "readinessCheck": true,
      "body": "필요한 선수 개념을 짧게 점검하고 막히면 해당 정의를 다시 확인한다. 이 진단은 준비 안내이며 숙달도나 완료 점수에 자동 반영되지 않는다."
    },
    {
      "id": "concept",
      "type": "ExplanationBlock",
      "title": "핵심 개념 여섯 걸음",
      "sections": [
        {
          "id": "m5-06-u1",
          "title": "지수함수의 밑 조건",
          "body": "실수 지수함수의 밑은 양수이고 1이 아니어야 한다.",
          "activity": "밑을 허용 구간과 제외값 1에 놓는다.",
          "check": "a=2는 허용되지만 a=1은 지수함수가 아닌 상수함수이다."
        },
        {
          "id": "m5-06-u2",
          "title": "기준점과 정의역",
          "body": "y=aˣ는 x=0에서 1을 지나며 모든 실수 x에서 정의된다.",
          "activity": "x 입력을 음수·0·양수로 바꾸어 표를 만든다.",
          "check": "a=3일 때 점 (0,1)을 지난다."
        },
        {
          "id": "m5-06-u3",
          "title": "치역과 점근선",
          "body": "aˣ는 항상 양수이고 x가 한쪽으로 커질 때 0에 가까워지지만 0이 되지 않는다.",
          "activity": "표와 그래프에서 y=0과의 거리를 살핀다.",
          "check": "기본 그래프의 치역은 y>0, 수평점근선은 y=0이다."
        },
        {
          "id": "m5-06-u4",
          "title": "밑에 따른 증가·감소",
          "body": "a>1이면 증가하고 0<a<1이면 감소한다.",
          "activity": "두 밑 범위에서 같은 입력 순서의 출력 표를 비교한다.",
          "check": "2ˣ은 증가하고 (1/2)ˣ은 감소한다."
        },
        {
          "id": "m5-06-u5",
          "title": "수평이동",
          "body": "y=a^(x−h)는 y=aˣ를 오른쪽 h만큼 옮긴다.",
          "activity": "h를 바꾸고 기준점의 x좌표가 어떻게 변하는지 추적한다.",
          "check": "y=2^(x−3)은 (3,1)을 지난다."
        },
        {
          "id": "m5-06-u6",
          "title": "수직이동과 그래프 읽기",
          "body": "y=a^(x−h)+k는 그래프와 점근선을 위아래 k만큼 이동시킨다.",
          "activity": "h,k 조작 후 기준점·치역·점근선을 함께 표시한다.",
          "check": "y=2^(x−1)−2의 수평점근선은 y=−2이고 치역은 y>−2이다."
        }
      ],
      "body": "정의와 조건을 먼저 확인하고 사례와 표를 살펴본 뒤 기호로 설명한다. 각 변형 뒤 원래 조건에 대입해 검산한다."
    },
    {
      "id": "lab",
      "type": "InteractiveBlock",
      "title": "개념 조작 미리보기 초안",
      "interaction": "expression-table",
      "description": "학습자가 표·표현·그래프의 대응을 조작하는 데이터 초안이다. 키보드 조작과 텍스트 대안은 구현 및 QA가 필요하다."
    },
    {
      "id": "example",
      "type": "WorkedExampleBlock",
      "title": "풀이 과정을 따라가요",
      "steps": [
        "a=2는 허용되지만 a=1은 지수함수가 아닌 상수함수이다.",
        "a=3일 때 점 (0,1)을 지난다.",
        "각 단계에서 정의역·조건을 기록하고 계산 뒤 원래 식에 대입해 확인한다."
      ]
    },
    {
      "id": "practice",
      "type": "PracticeBlock",
      "title": "검수 전 연습 문항 초안",
      "purpose": "practice",
      "hint": "검수 전 문제 원형 연결: m5-06-family-1 (m5-06-skill-1) → m506-draft-01, m506-draft-04; m5-06-family-2 (m5-06-skill-2) → m506-draft-02, m506-draft-05; m5-06-family-3 (m5-06-skill-2) → m506-draft-03, m506-draft-06. 실제 문항·정답은 별도 문제은행에서 제출 전 비공개로 제공한다."
    },
    {
      "id": "feedback",
      "type": "FeedbackBlock",
      "title": "오답을 개념으로 되돌리기",
      "body": "오답에서 놓친 정의, 조건 또는 표현을 확인하고 연결된 소단원으로 돌아간다. 오개념은 검증 전 설계 가설이다."
    },
    {
      "id": "review",
      "type": "ReviewBlock",
      "title": "복습과 다음 단원",
      "body": "도움 없이 다른 조건에서 핵심 절차를 다시 설명하고 선수 개념과 다음 단원 연결을 확인한다."
    }
  ],
