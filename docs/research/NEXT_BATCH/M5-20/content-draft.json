    "version": "0.1.0-draft",
    "blocks": [
      {
        "id": "goals",
        "title": "학습 목표",
        "type": "ConceptBlock",
        "body": "• 등차수열의 공차 d를 연속 항의 차로 정의하고 양수·0·음수 공차를 구별한다.\n• a_n=a_1+(n−1)d를 유도하고 첫째항과 끝항을 짝지어 S_n=n(a_1+a_n)/2를 설명한다."
      },
      {
        "id": "diagnostic",
        "title": "선수학습 확인",
        "type": "ExplanationBlock",
        "body": "이 진단은 준비 안내에만 사용하며 선수 단원의 prerequisite, 숙달도, 완료 점수를 변경하지 않습니다.",
        "readinessCheck": true
      },
      {
        "id": "concept",
        "title": "개념 설명",
        "type": "ExplanationBlock",
        "body": "등차수열은 a_{n+1}−a_n=d가 일정하다. a_1에서 n−1번 d를 더하므로 a_n=a_1+(n−1)d다. 유한합을 앞에서부터 쓴 식과 뒤에서부터 쓴 식을 더하면 각 항 쌍이 a_1+a_n이고 쌍은 n개가 되어 2S_n=n(a_1+a_n), 즉 S_n=n(a_1+a_n)/2다. 이는 d가 양수·0·음수인 경우 모두 성립한다.",
        "sections": [
          {
            "id": "m5-20-u1",
            "title": "연속 항의 차",
            "body": "공차 d는 다음 항에서 바로 앞 항을 뺀 값이다.",
            "activity": "수직 점 배열 간 차이를 표시하고 일정한지 확인한다.",
            "check": "7,4,1의 공차는 −3이다."
          },
          {
            "id": "m5-20-u2",
            "title": "공차의 부호와 변화",
            "body": "d>0이면 증가, d<0이면 감소, d=0이면 같은 항이 반복된다.",
            "activity": "양·음·영 공차 카드를 움직이며 항 표의 방향을 본다.",
            "check": "5,5,5의 공차는 0이다."
          },
          {
            "id": "m5-20-u3",
            "title": "일반항의 누적",
            "body": "첫 항에서 n−1번 공차를 더해 a_n=a_1+(n−1)d를 얻는다.",
            "activity": "반복 덧셈을 묶음 곱셈으로 바꿔 일반항을 만든다.",
            "check": "a_1=2,d=3이면 a_4=11이다."
          },
          {
            "id": "m5-20-u4",
            "title": "항 번호와 끝항",
            "body": "마지막 항 번호 n과 더할 공차 횟수 n−1을 구분한다.",
            "activity": "번호 레일 위에서 1항에서 n항까지 간격 수를 센다.",
            "check": "a_1=8,d=−2이면 a_5=0이다."
          },
          {
            "id": "m5-20-u5",
            "title": "앞뒤 항 짝짓기",
            "body": "첫째항+끝항, 둘째항+끝에서 둘째항은 모두 같은 합을 만든다.",
            "activity": "수열 카드를 앞에서와 뒤에서 동시에 짝짓는다.",
            "check": "2,5,8,11에서 양 끝 쌍의 합은 13이다."
          },
          {
            "id": "m5-20-u6",
            "title": "유한합 공식과 검산",
            "body": "S_n=n(a_1+a_n)/2를 사용하고 n, 끝항, 부호를 확인한다.",
            "activity": "항 수를 바꾸어 직접 합과 짝짓기 결과를 비교한다.",
            "check": "2+5+8+11=26이고 4(2+11)/2=26이다."
          }
        ]
      },
      {
        "id": "lab",
        "title": "시각적 탐구",
        "type": "InteractiveBlock",
        "interaction": "m5-20-visual"
      },
      {
        "id": "example",
        "title": "단계별 예제",
        "type": "WorkedExampleBlock",
        "steps": [
          "첫째항이 8, 공차가 −2인 등차수열의 처음 5항의 합을 구하라.",
          "a_5=8+4(−2)=0이다. 따라서 S_5=5(8+0)/2=20이다. 직접 더해도 8+6+4+2+0=20이다.",
          "공차가 음수여도 앞뒤 짝의 합 공식은 성립하고, 마지막 항 번호까지 공차를 4번 더했다."
        ]
      },
      {
        "id": "practice",
        "title": "연습 계획",
        "type": "PracticeBlock",
        "purpose": "practice",
        "hint": "먼저 적용할 규칙과 범위를 말로 확인한 뒤 연습 초안을 풉니다. 정답과 해설은 제출 전에 공개하지 않습니다."
      },
      {
        "id": "feedback",
        "title": "오답 교정",
        "type": "FeedbackBlock",
        "body": "오답은 규칙·범위·계산 단계를 나누어 확인하고 관련 소단원으로 돌아갑니다. 오개념 문구는 빈도 주장이 아닌 점검 가설입니다.\n• 공차를 앞 항−뒤 항으로 계산한다.\n• 감소하는 등차수열의 공차를 양수로 쓴다.\n• 일반항에 n 대신 n−1을 처음 항 수처럼 잘못 넣는다.\n• 공차를 n번 더한다.\n• 짝짓기 공식에서 2로 나누는 것을 빠뜨린다."
      },
      {
        "id": "review",
        "title": "복습과 다음 단원",
        "type": "ReviewBlock",
        "body": "핵심 규칙과 조건을 떠올리고 간격을 두어 복습합니다."
      }
    ],
