    "sequence": "구체적 상황·그림 관찰 → 용어와 관계 확인 → 기호화 → 원리 설명 → 독립 적용·검산",
    "principleDerivation": "표의 값과 식의 관계를 판별하고 그래프의 점과 연결한다.",
    "accessibility": "색상 외에 각·좌표·식의 이름과 텍스트 설명을 함께 제공한다. 모든 수치 조절은 키보드 입력 가능하며 갱신 결과는 aria-live 텍스트로 안내한다."
  },
  "subunits": [
    {
      "id": "m1-14-u1",
      "title": "정비례 관계 관찰",
      "targetSkills": [
        "m1-14-skill-1"
      ],
      "explanation": "x가 일정한 배가 되면 y도 같은 배가 되는 관계를 찾는다.",
      "activity": "표에서 y/x의 비를 비교한다.",
      "check": "비가 일정한 표를 골라 이유를 설명한다."
    },
    {
      "id": "m1-14-u2",
      "title": "정비례식과 비례상수",
      "targetSkills": [
        "m1-14-skill-1"
      ],
      "explanation": "정비례는 y=kx이며 k는 y/x로 구한다.",
      "activity": "쌍 (x,y)를 표에서 식으로 옮긴다.",
      "check": "주어진 값에서 k와 식을 구한다."
    },
    {
      "id": "m1-14-u3",
      "title": "정비례 표와 그래프",
      "targetSkills": [
        "m1-14-skill-2"
      ],
      "explanation": "정비례 표의 점은 원점을 지나는 직선 위에 놓인다.",
      "activity": "표의 점을 좌표평면에 놓고 직선으로 연결한다.",
      "check": "그래프가 원점을 지나는지 확인한다."
    },
    {
      "id": "m1-14-u4",
      "title": "반비례 관계 관찰",
      "targetSkills": [
        "m1-14-skill-2"
      ],
      "explanation": "x가 일정 배가 될 때 y는 그 역수 배가 되는 관계를 찾는다.",
      "activity": "표에서 xy의 곱이 일정한지 비교한다.",
      "check": "곱이 일정한 표를 반비례로 구별한다."
    },
    {
      "id": "m1-14-u5",
      "title": "반비례식과 제한",
      "targetSkills": [
        "m1-14-skill-3"
      ],
      "explanation": "반비례는 y=k/x이며 x≠0이다.",
      "activity": "xy의 일정한 값에서 빠진 값을 계산한다.",
      "check": "x=0을 허용하지 않는 이유를 말한다."
    },
    {
      "id": "m1-14-u6",
      "title": "표·식·그래프 연결",
      "targetSkills": [
        "m1-14-skill-3"
      ],
      "explanation": "상황·표·식·그래프 사이의 대응을 해석한다.",
      "activity": "직접/역비례 표 카드를 식과 그래프에 연결한다.",
      "check": "여러 표현이 같은 관계인지 검산한다."
    }
  ],
