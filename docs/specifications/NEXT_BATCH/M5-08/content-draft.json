  "blocks": [
    {
      "id": "goals",
      "type": "ConceptBlock",
      "title": "오늘의 학습 목표",
      "body": "• 같은 양의 밑으로 나타낼 수 있는 지수방정식에서 지수의 같음을 이용해 해를 구한다.\n• 지수함수의 단조 방향에 따라 지수부등식의 부등호 방향을 보존하거나 뒤집는다.\n검수 전 학습 초안이며 점수 결과를 보장하지 않는다."
    },
    {
      "id": "diagnostic",
      "type": "ExplanationBlock",
      "title": "시작 전 선수학습 확인",
      "readinessCheck": true,
      "body": "필요한 선수 개념을 짧게 점검하고 막히면 해당 정의를 다시 확인한다. 이 진단은 준비 안내이며 숙달도나 완료 점수에 자동 반영되지 않는다."
    },
    {
      "id": "concept",
      "type": "ExplanationBlock",
      "title": "핵심 개념 여섯 걸음",
      "sections": [
        {
          "id": "m5-08-u1",
          "title": "지수방정식 전 밑 확인",
          "body": "실수 지수에서 밑은 양수이고 1이 아니어야 지수함수가 일대일이다.",
          "activity": "밑 조건을 통과한 식과 통과하지 못한 식을 분류한다.",
          "check": "2ˣ과 (1/2)ˣ은 허용되지만 1ˣ은 일대일이 아니다."
        },
        {
          "id": "m5-08-u2",
          "title": "같은 밑으로 나타내기",
          "body": "한쪽 또는 양쪽을 같은 양의 밑 거듭제곱으로 바꾼다.",
          "activity": "작은 정수 거듭제곱 표에서 같은 밑 표현을 찾는다.",
          "check": "8=2³이므로 2^(x+1)=8은 2^(x+1)=2³이다."
        },
        {
          "id": "m5-08-u3",
          "title": "지수 비교 방정식",
          "body": "동일한 허용 밑에서 지수값이 같으면 지수들이 같다.",
          "activity": "밑을 맞춘 뒤 지수만 비교해 일차식을 푼다.",
          "check": "2^(x+1)=2³에서 x=2이다."
        },
        {
          "id": "m5-08-u4",
          "title": "a>1인 지수부등식",
          "body": "증가하는 지수함수는 입력 순서를 보존한다.",
          "activity": "2^x 표의 입력·출력 순서를 대조한다.",
          "check": "2^x<2³이면 x<3이다."
        },
        {
          "id": "m5-08-u5",
          "title": "0<a<1인 지수부등식",
          "body": "감소하는 지수함수는 입력 순서를 뒤집는다.",
          "activity": "(1/2)^x 표에서 입력 증가 때 출력 감소를 확인한다.",
          "check": "(1/2)^x>(1/2)^2이면 x<2이다."
        },
        {
          "id": "m5-08-u6",
          "title": "해 검산과 범위 구분",
          "body": "풀이 결과를 원래 식과 밑 조건에 확인하고 방정식과 부등식을 구분한다.",
          "activity": "후보 해를 대입하고 수직선에 해집합을 표시한다.",
          "check": "(1/3)^(2x−1)>(1/3)^3이면 2x−1<3이므로 x<2이다."
        }
      ],
      "body": "정의와 조건을 먼저 확인하고 사례와 표를 살펴본 뒤 기호로 설명한다. 각 변형 뒤 원래 조건에 대입해 검산한다."
    },
    {
      "id": "lab",
      "type": "InteractiveBlock",
      "title": "개념 조작 미리보기 초안",
      "interaction": "expression-table",
      "description": "학습자가 표·표현·그래프의 대응을 조작하는 데이터 초안이다. 키보드 조작과 텍스트 대안은 구현 및 QA가 필요하다."
    },
    {
      "id": "example",
      "type": "WorkedExampleBlock",
      "title": "풀이 과정을 따라가요",
      "steps": [
        "2ˣ과 (1/2)ˣ은 허용되지만 1ˣ은 일대일이 아니다.",
        "8=2³이므로 2^(x+1)=8은 2^(x+1)=2³이다.",
        "각 단계에서 정의역·조건을 기록하고 계산 뒤 원래 식에 대입해 확인한다."
      ]
    },
    {
      "id": "practice",
      "type": "PracticeBlock",
      "title": "검수 전 연습 문항 초안",
      "purpose": "practice",
      "hint": "자체 제작 초안이다. 정답 및 해설은 학습자가 제출하기 전 공개하지 않으며 사람 검수 전 운영 공개하지 않는다."
    },
    {
      "id": "feedback",
      "type": "FeedbackBlock",
      "title": "오답을 개념으로 되돌리기",
      "body": "오답에서 놓친 정의, 조건 또는 표현을 확인하고 연결된 소단원으로 돌아간다. 오개념은 검증 전 설계 가설이다."
    },
    {
      "id": "review",
      "type": "ReviewBlock",
      "title": "복습과 다음 단원",
      "body": "도움 없이 다른 조건에서 핵심 절차를 다시 설명하고 선수 개념과 다음 단원 연결을 확인한다."
    }
  ],
