  "blocks": [
    {
      "id": "goals",
      "type": "ConceptBlock",
      "title": "오늘의 학습 목표",
      "body": "정수 곱셈·나눗셈 결과의 부호를 인수·피제수와 제수의 부호로 판정한다.\n곱셈의 반복·대칭성과 역연산을 사용해 정수 곱셈 규칙을 설명한다.\n0으로 나누기가 정의되지 않음을 설명하고 나눗셈 결과를 검산한다.\n곱셈·나눗셈 계산에서 부호 오류와 연산 순서 오류를 구별한다."
    },
    {
      "id": "diagnostic",
      "type": "ExplanationBlock",
      "title": "시작 전 선수학습 확인",
      "readinessCheck": true,
      "body": "M1-01에서 정수의 부호와 수직선 위치를 읽는다.\nM0-04에서 자연수 곱셈·나눗셈과 곱셈구구를 활용한다."
    },
    {
      "id": "concept",
      "type": "ExplanationBlock",
      "title": "핵심 개념 여섯 걸음",
      "sections": [
        {
          "id": "m1-02-u1",
          "title": "부호와 곱의 크기 분리",
          "body": "곱셈에서 절댓값은 크기 계산, 부호는 방향 정보를 맡는다.",
          "activity": "부호 카드와 자연수 묶음을 따로 조합한다.",
          "check": "크기와 부호를 분리해 답을 예측한다."
        },
        {
          "id": "m1-02-u2",
          "title": "양수와 음수의 곱",
          "body": "부호 조합별 곱의 결과를 작은 수 패턴과 수직선 이동으로 확인한다.",
          "activity": "규칙적인 곱 표를 완성한다.",
          "check": "양·음 곱의 부호를 근거와 함께 설명한다."
        },
        {
          "id": "m1-02-u3",
          "title": "세 수 이상의 곱",
          "body": "음수 인수의 개수와 결과 부호의 관계를 탐구한다.",
          "activity": "음수 인수 하나를 추가할 때 부호 변화를 관찰한다.",
          "check": "홀수·짝수 개의 음수 인수로 부호를 판정한다."
        },
        {
          "id": "m1-02-u4",
          "title": "나눗셈과 곱셈의 역관계",
          "body": "나눗셈은 곱셈으로 되돌려 확인할 수 있다.",
          "activity": "a÷b의 결과 후보를 b×x=a로 검증한다.",
          "check": "나눗셈 결과의 부호와 크기를 확인한다."
        },
        {
          "id": "m1-02-u5",
          "title": "0과 나눗셈 조건",
          "body": "0을 곱한 결과와 0으로 나누려는 시도를 구별한다.",
          "activity": "방정식 0×x=a의 해 유무를 사례로 분류한다.",
          "check": "0으로 나누기가 정의되지 않는 이유를 설명한다."
        },
        {
          "id": "m1-02-u6",
          "title": "계산·검산·오류 교정",
          "body": "부호 규칙, 계산, 곱셈 검산을 순서대로 적용한다.",
          "activity": "오류 풀이의 첫 잘못된 단계를 표시한다.",
          "check": "계산 결과를 역연산으로 검산한다."
        }
      ],
      "body": "반복 곱셈 상황 → 곱의 부호 관찰 → 부호 규칙 설명 → 나눗셈을 역연산으로 연결 → 0/나눗셈 조건 → 검산"
    },
